DISCORD_TOKEN=
NEIS_TOKEN=
CLIENT_ID=
GUILD_ID=
OWNER_ID=

# Lavalink (music)
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=CHANGE_ME
# 봇을 실행할 때 같은 컴퓨터의 Lavalink도 함께 실행합니다 (기본 켜짐, 0이면 끔)
LAVALINK_AUTOSTART=1
CLIENT_ID=
YTDLP_PATH=yt-dlp

# 음원 파일 캐시 (기본 꺼짐: 0). 음원 파일 저장은 저작권 위험이 있어 꼭 필요할 때만 용량(MB)을 지정해 켜세요
MUSIC_CACHE_MAX_MB=0
MUSIC_CACHE_MAX_MINUTES=30
MUSIC_CACHE_PORT=2334
YTDLP_USE_WORKER=1

# 봇이 서버에 들어가면 자동으로 바꿀 서버 별명 (기본 OMNI, off면 사용 안 함)
BOT_NICKNAME=OMNI

# 음악 추천에서 스포티파이 재생목록·앨범을 쓰려면 스포티파이 개발자 앱의 키를 넣으세요 (선택, 비워 두면 스포티파이는 사용 불가)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# 키가 없거나 API가 막힌 재생목록은 스포티파이 공개 웹 페이지에서 읽습니다 (기본 켜짐, 0이면 끔. 스포티파이 이용약관은 자동 수집을 금지합니다)
SPOTIFY_WEB_FALLBACK=1

# 공식 웹사이트 주소 (이용약관·개인정보 처리방침 링크에 사용, 끝의 / 없이). 사이트를 새 주소로 게시하면 이 값만 바꾸세요
SITE_URL=https://felnut.github.io/OMNI-Bot

# 서버별 이용 기록 저장과 '현재 서버' 랭킹 (기본 꺼짐. 개인정보 처리방침 개정본 시행 후 1로 켜기)
GUILD_RANK_ENABLED=0

# 외부 상태 감시 송신 (수신 API 구현 후 활성화, 기본 꺼짐)
MONITOR_ENABLED=0
MONITOR_BASE_URL=https://omni.felnut.com
MONITOR_REGISTER_SECRET=
